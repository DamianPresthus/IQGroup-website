---
import Base from '../layouts/Base.astro';
import SectorTiles from '../components/SectorTiles.astro';
import Quotes from '../components/Quotes.astro';
import Method from '../components/Method.astro';
import Contact from '../components/Contact.astro';
import Face from '../components/Face.astro';
import { getOrdered, iconImage, logoImage } from '../lib/content';
import heroMap from '../assets/hero-map.svg?raw'; // generated by tools/v4-map/dots.mjs

const [clients, hires, people, sectors] = await Promise.all([
  getOrdered('clients'), getOrdered('hires'), getOrdered('people'), getOrdered('sectors'),
]);
const iconFor = new Map(sectors.map((s) => [s.id, iconImage(s.data.icon)]));
const partners = people.filter((p) => p.data.group === 'partner');
const counts = { partners: partners.length, associates: people.filter((p) => p.data.group === 'associate').length };
const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
---
<Base
  title="IQ Group · Executive Search, Mumbai"
  description="IQ Group is a partner-led executive search and HR advisory firm headquartered in Mumbai. Banking and financial services, consulting, FMCG, legal, media, advertising, hospitality and social impact, from specialist roles to the C‑suite, for 30+ years."
  current="home"
>
  <header class="hero" id="top">
    <figure class="hero-map" set:html={heroMap} />
    <div class="page hero-grid">
      <div>
        <h1>Hires that move your organisation forward.</h1>
        <p class="lead">Partner-led executive search and HR advisory <br>from specialist roles to the C‑suite, across India, the Middle East, South Asia and Europe for 30+ years.</p>
        <div class="hero-ctas">
          <a class="btn btn-accent" href="#contact" data-enquiry="search">Begin a search <span class="arrow" aria-hidden="true">→</span></a>
          <a class="link-arrow" href="#candidates" data-enquiry="profile">Share your profile</a>
        </div>
      </div>
    </div>
  </header>

  <section class="trust" aria-label="Clients">
    <div class="page trust-row">
      <span class="trust-label">Clients include</span>
      <ul class="trust-logos">
        {clients.map(({ id, data }) => {
          const src = logoImage(data.file).src;
          return (
            <li class:list={[{ hul: id === 'hul' }]}>
              <span class="logo" style={`--h:${data.height}; --logo:url('${src}')`}><img src={src} alt={data.showName ? '' : data.name} height={data.height} /></span>
              {data.showName && <span class="logo-name">{data.name}</span>}
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <section class="section sectors-strip" id="sectors" aria-labelledby="sectors-title">
    <div class="page">
      <div class="section-head"><h2 id="sectors-title">Sectors</h2></div>
      <SectorTiles />
    </div>
  </section>

  <section class="section" id="hires" aria-labelledby="hires-title">
    <div class="page">
      <div class="section-head"><h2 id="hires-title">Recent hires</h2></div>
      <ul class="hire-rows rise">
        {hires.map(({ data }) => (
          <li><img class="sector-icon" src={iconFor.get(data.sector.id)!.src} alt="" width="384" height="384" decoding="async" /><b>{data.role}</b><span class="org">{data.org}</span><span class="sec">{data.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band" id="partners" aria-labelledby="partners-title">
    <div class="page">
      <div class="section-head">
        <h2 id="partners-title">A partner on every search.</h2>
        <p>Each mandate is led personally by one of our {words[counts.partners]} partners, with {words[counts.associates]} associates and an advisor behind them.</p>
      </div>
      <ul class="partners rise">
        {partners.map(({ data }) => <li><Face face={data.face} /><b>{data.name}</b><span>{data.title}</span></li>)}
      </ul>
      <p class="partners-more"><a class="link-arrow" href="/about/#people">Meet the team</a></p>
    </div>
  </section>

  <Quotes />
  <Method />
  <Contact />
</Base>
