---
// <head> SEO: canonical URL, Open Graph / Twitter card, robots, and schema.org JSON-LD built from src/content
// (site.yaml for the firm, people.yaml for the partners). Brief §7: Organization + ProfessionalService + Person,
// LocalBusiness address for Dadar, consistent "IQ Group · Executive Search, Mumbai" naming.
import { getOrdered, getSite } from '../lib/content';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const site = await getSite();
const people = await getOrdered('people');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
// Search engines may list the site only when the production build sets PUBLIC_INDEXABLE=true (set it in Cloudflare
// Pages once the iqgroup.co.in domain points here). Previews and *.pages.dev stay out of search results.
const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true' && !noindex;

const a = site.address;
const org = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'Organization'],
  '@id': `${site.url}/#org`,
  name: site.name,
  alternateName: 'IQ Group Executive Search',
  url: `${site.url}/`,
  logo: new URL('/iq-mark.png', Astro.site).href,
  image: ogImage.href,
  description: 'Partner-led executive search and HR advisory firm headquartered in Mumbai.',
  email: site.email,
  telephone: site.phones[0].tel,
  address: { '@type': 'PostalAddress', streetAddress: a.street, addressLocality: a.city, postalCode: a.postcode, addressCountry: a.countryCode },
  areaServed: site.areaServed,
  memberOf: { '@type': 'Organization', name: 'Executive Recruiters Association' },
  founder: people.filter((p) => p.data.founder).map((p) => ({ '@type': 'Person', name: p.data.name, jobTitle: p.data.title })),
  employee: people
    .filter((p) => p.data.group === 'partner')
    .map((p) => ({ '@type': 'Person', name: p.data.name, jobTitle: p.data.title, worksFor: { '@id': `${site.url}/#org` } })),
};
---
<link rel="canonical" href={canonical.href}>
<meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'}>
<meta property="og:type" content="website">
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical.href}>
<meta property="og:image" content={ogImage.href}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="en_GB">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#FAF9F5">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script type="application/ld+json" set:html={JSON.stringify(org)} />
